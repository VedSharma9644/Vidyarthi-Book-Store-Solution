# Server Configuration
PORT=5000
NODE_ENV=development

# SMS API Configuration
TWO_FACTOR_API_KEY=ce34ca26-2e5c-11f0-8b17-0200cd936042
TWO_FACTOR_TEMPLATE=OTP1
FAST2SMS_AUTHORIZATION=dLzw9Ria2Hv75ybJVYSpsh0ueBPfCg3T1loENxnIXrQKG8UkOFKeVt3Elm2bikucMAs1Zh0yP5rwB69f

# JWT Configuration (for future use)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=30d

# CORS Configuration
CORS_ORIGIN=http://localhost:19006,http://localhost:3000

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_RATE_LIMIT_WINDOW_MS=60000
OTP_RATE_LIMIT_MAX_REQUESTS=3

# Firebase Configuration
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Razorpay Configuration
# Get your keys from: https://dashboard.razorpay.com/app/keys
# Use Test keys (rzp_test_...) for testing the purchase flow; Live keys (rzp_live_...) for production.
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Razorpay webhook signing secret (Dashboard → Webhooks → your endpoint → secret)
RAZORPAY_WEBHOOK_SECRET=

# Payment reconciliation (npm run reconcile-payments)
# Same Firebase + Razorpay credentials as the API. Run on a schedule (e.g. every 5–10 minutes) in production.

# Backfill missing student names on EXISTING orders (no new orders created):
#   npm run backfill-order-metadata -- --dry-run
#   npm run backfill-order-metadata -- --days=60 --limit=300

# Mobile app version policy (Firestore app_config/mobile — preferred over env)
# Seed: node scripts/seed-app-version-policy.js
# Set forceUpdateEnabled: true in Firestore to block outdated app versions (requires X-App-Version from app).
# APP_FORCE_UPDATE_ENABLED=true
# APP_MIN_VERSION_ANDROID=1.0.18
# APP_MIN_VERSION_IOS=1.0.18
